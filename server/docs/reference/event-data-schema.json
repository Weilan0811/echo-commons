  "checkpoint": {
    "additionalProperties": false,
    "properties": {},
    "title": "CheckpointData",
    "type": "object"
  },
  "resync_required": {
    "additionalProperties": false,
    "properties": {
      "reason": {
        "const": "cursor_expired",
        "title": "Reason",
        "type": "string"
      }
    },
    "required": [
