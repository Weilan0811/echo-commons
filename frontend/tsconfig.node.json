{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "skipLibCheck": true,
    "noEmit": true,

    "composite": true,
    "outDir": "./node_modules/.tmp/tsbuild",
  },
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}